# file = data contoh lokal (tanpa Neo4j) | neo4j = graf hasil pipeline
DATA_SOURCE=file
# Hanya untuk DATA_SOURCE=neo4j. Gunakan akun dengan hak BACA saja.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j
# Origin frontend yang diizinkan (CORS), pisahkan dengan koma
CORS_ORIGINS=http://localhost:5173
