 "nodes": {
  "Tweet": [
   {
    "tweet_id": "T01",
    "upload": "2026-01-12T06:42:00+07:00",
    "text": "Gunung Semeru erupsi pagi ini, abu vulkanik terlihat dari Supiturang sampai Ampelgading. Warga diminta menjauhi aliran sungai.",
    "url": null
   },
   {
    "tweet_id": "T02",
    "upload": "2026-01-12T09:15:00+07:00",
    "text": "Sebagian warga Supiturang mulai mengungsi ke Kecamatan Candipuro, sekitar 120 jiwa. Masker sangat dibutuhkan.",
    "url": null
   },
   {
    "tweet_id": "T03",
    "upload": "2026-01-14T17:20:00+07:00",
    "text": "Kolom abu Semeru kembali naik sore ini, pengamatan dari pos pantau.",
    "url": null
   },
   {
    "tweet_id": "T04",
    "upload": "2026-01-20T08:05:00+07:00",
    "text": "Material erupsi menimbun 8 rumah di Desa Sumberwuluh. Petugas BPBD Lumajang sudah di lokasi.",
    "url": null
   },
   {
    "tweet_id": "T05",
    "upload": "2026-01-27T13:30:00+07:00",
    "text": "Posko pengungsian Semeru butuh tenda tambahan, masker dari BNPB sudah datang ke Supiturang.",
    "url": null
   },
   {
    "tweet_id": "T06",
    "upload": "2026-02-03T16:10:00+07:00",
    "text": "Banjir lahar dingin melintas Sumberwuluh menuju Jembatan Gladak Perak, warga jangan mendekat.",
    "url": null
   },
   {
    "tweet_id": "T07",
    "upload": "2026-02-04T07:55:00+07:00",
    "text": "Jembatan Gladak Perak putus diterjang lahar, akses Candipuro terganggu.",
    "url": null
   },
   {
    "tweet_id": "T08",
    "upload": "2026-02-05T10:40:00+07:00",
    "text": "Arus lalu lintas di Candipuro dialihkan setelah banjir lahar kemarin.",
    "url": null
   },
   {
    "tweet_id": "T09",
    "upload": "2026-01-15T11:00:00+07:00",
    "text": "Hujan abu tipis di Ampelgading, warga diimbau memakai masker.",
    "url": null
   },
   {
    "tweet_id": "T10",
    "upload": "2026-02-10T05:50:00+07:00",
    "text": "Longsor menutup jalan desa di Dampit setelah hujan deras semalam.",
    "url": null
   },
   {
    "tweet_id": "T11",
    "upload": "2026-02-11T12:25:00+07:00",
    "text": "Pembersihan material longsor Dampit masih berlangsung.",
    "url": null
   },
   {
    "tweet_id": "T12",
    "upload": "2026-03-02T15:45:00+07:00",
    "text": "Angin kencang di Kalirejo Lawang, 12 rumah dilaporkan rusak. Warga butuh terpal.",
    "url": null
   },
   {
    "tweet_id": "T13",
    "upload": "2026-03-03T09:10:00+07:00",
    "text": "Cuaca ekstrem melanda Kabupaten Malang, PMI turun membantu warga terdampak.",
    "url": null
   },
   {
    "tweet_id": "T14",
    "upload": "2026-01-22T20:05:00+07:00",
    "text": "Longsor di Sumberbrantas menutup jalan, dan pagi tadi longsor susulan terjadi di titik yang sama.",
    "url": null
   },
   {
    "tweet_id": "T15",
    "upload": "2026-02-17T14:30:00+07:00",
    "text": "Banjir di Bumiaji, air masuk ke permukiman Sumberbrantas dan Bulukerto.",
    "url": null
   },
   {
    "tweet_id": "T16",
    "upload": "2026-03-09T16:50:00+07:00",
    "text": "Angin kencang merobohkan pohon di Sumberbrantas.",
    "url": null
   },
   {
    "tweet_id": "T17",
    "upload": "2026-03-09T17:05:00+07:00",
    "text": "Angin kencang juga terasa di Bulukerto, beberapa atap rumah rusak.",
    "url": null
   },
   {
    "tweet_id": "T18",
    "upload": "2026-01-08T04:30:00+07:00",
    "text": "Banjir mulai masuk permukiman Bangil dini hari ini.",
    "url": null
   },
   {
    "tweet_id": "T19",
    "upload": "2026-01-09T08:20:00+07:00",
    "text": "Sekitar 350 rumah terendam di Bangil, banjir meluas ke Beji. Warga butuh air bersih.",
    "url": null
   },
   {
    "tweet_id": "T20",
    "upload": "2026-01-10T10:00:00+07:00",
    "text": "BPBD Pasuruan masih mengevakuasi warga Bangil yang terjebak banjir.",
    "url": null
   },
   {
    "tweet_id": "T21",
    "upload": "2026-03-12T19:40:00+07:00",
    "text": "Bangil banjir lagi malam ini setelah hujan deras.",
    "url": null
   },
   {
    "tweet_id": "T22",
    "upload": "2026-03-13T07:15:00+07:00",
    "text": "Sekitar 90 rumah terendam di Bangil akibat banjir kedua bulan ini.",
    "url": null
   },
   {
    "tweet_id": "T23",
    "upload": "2026-03-16T13:05:00+07:00",
    "text": "Kebakaran lahan di lereng Gunung Arjuno, asap terlihat dari Prigen. Relawan pemadam dibutuhkan.",
    "url": null
   },
   {
    "tweet_id": "T24",
    "upload": "2026-03-18T09:35:00+07:00",
    "text": "Tim Manggala Agni memadamkan api di Arjuno, sekitar 40 hektare lahan terbakar.",
    "url": null
   },
   {
    "tweet_id": "T25",
    "upload": "2026-02-06T18:20:00+07:00",
    "text": "Longsor di Sukapura menutup akses ke Ngadisari.",
    "url": null
   },
   {
    "tweet_id": "T26",
    "upload": "2026-02-20T02:14:00+07:00",
    "text": "Gempa terasa cukup kuat di Puger dini hari, warga berhamburan keluar rumah.",
    "url": null
   },
   {
    "tweet_id": "T27",
    "upload": "2026-02-20T02:30:00+07:00",
    "text": "Gempa dirasakan di Jember, pusat gempa di laut sekitar 90 km barat daya. 3 bangunan rusak ringan.",
    "url": null
   },
   {
    "tweet_id": "T28",
    "upload": "2026-01-30T22:10:00+07:00",
    "text": "Banjir bandang menerjang Panti malam ini, Basarnas menuju lokasi.",
    "url": null
   },
   {
    "tweet_id": "T29",
    "upload": "2026-01-31T07:45:00+07:00",
    "text": "Dua warga Panti meninggal akibat banjir bandang. Obat-obatan dibutuhkan di posko.",
    "url": null
   },
   {
    "tweet_id": "T30",
    "upload": "2026-03-05T06:30:00+07:00",
    "text": "Banjir merendam rumah warga di Porong.",
    "url": null
   },
   {
    "tweet_id": "T31",
    "upload": "2026-03-06T08:00:00+07:00",
    "text": "Genangan banjir di Porong belum surut pagi ini.",
    "url": null
   }
