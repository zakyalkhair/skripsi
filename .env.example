# twscrape — satu akun per kelompok variabel, boleh lebih dari satu akun (X_ACCOUNT_2_...)
# COOKIES lebih stabil daripada login password. Format WAJIB (dengan tanda kutip):
#   X_ACCOUNT_1_COOKIES="auth_token=NILAI; ct0=NILAI"
# Ambil dari browser: login x.com -> F12 -> Application -> Cookies -> https://x.com
X_ACCOUNT_1_USERNAME=
X_ACCOUNT_1_PASSWORD=
X_ACCOUNT_1_EMAIL=
X_ACCOUNT_1_EMAIL_PASSWORD=
X_ACCOUNT_1_COOKIES=

# Tahap 1.4 (filter informatif) — API key gratis dari https://console.groq.com (menu API Keys)
GROQ_API_KEY=

# String acak rahasia, buat sekali dan jangan diganti selama penelitian:
#   python -c "import secrets; print(secrets.token_hex(32))"
USER_HASH_SALT=
